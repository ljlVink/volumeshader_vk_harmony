set(FILES volume.vert volume_reference.frag volume_optimized.frag present.vert present.frag)
set(NAMES vertex fragmentReference fragmentOptimized presentVertex presentFragment)
get_filename_component(OUTPUT_DIR "${OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
file(WRITE "${OUTPUT}" "#pragma once\n#include <array>\n#include <cstdint>\nnamespace volume::shaders {\n")
foreach(INDEX RANGE 0 4)
    list(GET FILES ${INDEX} FILE)
    list(GET NAMES ${INDEX} NAME)
    file(READ "${INPUT_DIR}/${FILE}.spv" HEX HEX)
    string(LENGTH "${HEX}" LENGTH)
    math(EXPR COUNT "${LENGTH} / 8")
    math(EXPR REMAINDER "${LENGTH} % 8")
    if(NOT REMAINDER EQUAL 0)
        message(FATAL_ERROR "Invalid SPIR-V length: ${FILE}")
    endif()
    string(REGEX MATCHALL "........" WORDS "${HEX}")
    set(CONTENT "inline constexpr std::array<uint32_t, ${COUNT}> ${NAME} = {\n")
    set(COLUMN 0)
    foreach(WORD IN LISTS WORDS)
        string(SUBSTRING "${WORD}" 0 2 B0)
        string(SUBSTRING "${WORD}" 2 2 B1)
        string(SUBSTRING "${WORD}" 4 2 B2)
        string(SUBSTRING "${WORD}" 6 2 B3)
        string(APPEND CONTENT "0x${B3}${B2}${B1}${B0}u,")
        math(EXPR COLUMN "(${COLUMN} + 1) % 8")
        if(COLUMN EQUAL 0)
            string(APPEND CONTENT "\n")
        endif()
    endforeach()
    string(APPEND CONTENT "\n};\n")
    file(APPEND "${OUTPUT}" "${CONTENT}")
endforeach()
file(APPEND "${OUTPUT}" "}\n")
